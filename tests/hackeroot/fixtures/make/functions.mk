FILES := a.c b.c c.h
SOURCES := $(filter %.c,$(FILES))
HEADERS := $(filter-out %.c,$(FILES))
OBJECTS := $(patsubst %.c,%.o,$(SOURCES))
SUFFIXED := $(SOURCES:.c=.o)
UPPER := $(subst a,A,banana)
STRIPPED := $(strip   a   b  )
PICKED := $(if $(FILES),yes,no)
EMPTY_PICK := $(if $(NOTHING),yes,no)
greet = hello $(1) and $(2)
CALLED := $(call greet,x,y)
LOOPED := $(foreach f,$(SOURCES),[$(f)])
ORIGIN_FILE := $(origin FILES)
ORIGIN_NONE := $(origin NOTHING)
FIRST := $(firstword $(FILES))
COUNT := $(words $(FILES))
DIRS := $(dir src/a.c b.c)
NAMES := $(notdir src/a.c b.c)
SORTED := $(sort c a b a)
FOUND := $(findstring an,banana)
PREFIXED := $(addprefix -I,inc src)
DOLLAR := $$HOME
