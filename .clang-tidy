---
# Magic numbers are excluded because N64 graphics code is inherently full of
# bit masks and shifts that are clearer as literals next to the spec they encode.
#
# The pro-bounds and pro-type-vararg checks are excluded because ImGui and SDL
# are C APIs: style.Colors[slot], SDL's char* const* results and the printf-style
# text calls cannot be expressed without tripping them.
#
# avoid-const-or-ref-data-members is excluded because the parsers are written as
# worker classes that live for one call and borrow their inputs; copying a
# SourceSet or a token buffer into each of them is the opposite of the point.

Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-vararg,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-designated-initializers,
  -modernize-use-std-numbers,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-redundant-parentheses,
  -readability-trailing-comma

WarningsAsErrors: ''
# clang-cl maps /WX to -Werror, which turns this clang-only pedantry into a hard
# error on every designated initializer that leaves a defaulted member alone.
ExtraArgs:
  - '-Wno-missing-designated-field-initializers'
HeaderFilterRegex: '.*[/\\]src[/\\].*'
FormatStyle: file

CheckOptions:
  # MSVC's std::map and std::unordered_map allocate a sentinel node when moved,
  # so every type owning one (SourceSet, MacroTable, and the results holding
  # them) has a move constructor that can in principle throw bad_alloc. Nothing
  # we could write would change that short of replacing the containers.
  bugprone-exception-escape.CheckMoveMemberFunctions: false
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  # The fixed-width aliases in base/Types.h are deliberately spelled the way
  # the decomp and the gbi headers spell them, so they are exempt.
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^(SDL_GLContext|is_transparent|[usf](8|16|32|64)|usize)$'
  readability-identifier-naming.NamespaceCase: camelBack
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.PublicMemberCase: camelBack
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-function-cognitive-complexity.Threshold: 25
  # Umbrella and single-header third-party includes: include-cleaner wants the
  # individual SDL headers and cannot see through imgui's and toml++'s inlining.
  # <windows.h> likewise spreads the Win32 API over internal SDK headers (um/,
  # shared/) that nobody includes directly.
  misc-include-cleaner.IgnoreHeaders: 'SDL3.*;imgui.*;toml.*;catch2.*;windows\.h;.*[/\\]um[/\\].*;.*[/\\]shared[/\\].*'
